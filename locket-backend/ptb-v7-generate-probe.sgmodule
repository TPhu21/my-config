#!name=PTB V7 - Generate Hook Probe
#!desc=Read-only generateFilteredImage check on both Locket hosts; does not modify traffic.
#!system=ios

[MITM]
hostname = %APPEND% api.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net

[Script]
ptb_v7_generate_probe = type=http-request, pattern=^https:\/\/(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/generateFilteredImage(?:\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/feature/ptb-native-contract-diagnostics/locket-backend/ptb-v7-generate-probe.js, requires-body=false, timeout=20

#!name=Private PTB Native Bridge - EXPERIMENT
#!desc=Isolated user-owned Render staging redirect; independent of main Locket personal Gold config; unverified native support.
#!system=ios

[MITM]
enable = true
hostname = %APPEND% api.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net, firebaseremoteconfig.googleapis.com

[Script]
# A. Put experimental PTB selections into the Locket filter list.
ptb_getfilters = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/getFilters(?:\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/feature/ptb-native-contract-diagnostics/locket-backend/ptb-getfilters-response-compat.js, requires-body=true, max-size=524288, timeout=30

# B. Camera UI's Remote Config catalog gate. Can conflict with other RC response scripts; disable this experiment if Gold options disappear.
ptb_remoteconfig = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/[^/]+\/namespaces\/[^/]+:fetch(?:\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/feature/ptb-native-contract-diagnostics/locket-backend/ptb-remoteconfig-combined.js, requires-body=true, max-size=524288, timeout=30

# C. After selecting own PTB, redirect ONLY generation to own Render staging.
ptb_generate = type=http-request, pattern=^https:\/\/(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/generateFilteredImage(?:\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/feature/ptb-native-contract-diagnostics/locket-backend/native-ptb-redirect.js, requires-body=true, max-size=131072, timeout=60

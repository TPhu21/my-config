#!name=PTB getFilters Preview - DIAGNOSTIC V2
#!desc=One-endpoint metadata experiment. No Gold/Firebase edits; no photo, token, UID, or redirects.

[MITM]
enable = true
hostname = %APPEND% api.locketcamera.com

[Script]
ptb_getfilters_preview = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/getFilters(\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-backend/ptb-getfilters-test.js?diag=20261120v2, requires-body=false, timeout=15

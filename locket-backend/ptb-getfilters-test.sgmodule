ptb_getfilters_preview = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/getFilters(\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-backend/ptb-getfilters-test.js, requires-body=false, timeout=15

#!name=PTB Personal + Photobooth - ISOLATED TEST
#!desc=One combined personal+PTB Firebase script for numeric project fetch, plus getFilters. No photo upload redirect. Disable after test.

[MITM]
enable = true
hostname = %APPEND% api.locketcamera.com, firebaseremoteconfig.googleapis.com

[Script]
ptb_getfilters_response = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/getFilters(\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-backend/ptb-getfilters-response-compat.js?trial=20261120a, requires-body=true, max-size=1048576, timeout=15
ptb_firebase_catalog = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/[0-9]+\/namespaces\/[^/]+:fetch(\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-backend/ptb-remoteconfig-personal-merged.js?trial=20261120personal1, requires-body=true, max-size=1048576, timeout=15

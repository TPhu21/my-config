#!name=PTB Personal + Photobooth - COMPAT V3
#!desc=Experimental PTB category + own personal config for numeric/named Firebase fetch. No photo upload/redirect.

[MITM]
enable = true
hostname = %APPEND% api.locketcamera.com, firebaseremoteconfig.googleapis.com

[Script]
ptb_getfilters_response = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/getFilters(\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-backend/ptb-getfilters-response-compat.js?trial=20261121v3, requires-body=true, max-size=1048576, timeout=15
ptb_firebase_catalog = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/[^/]+\/namespaces\/[^/]+:fetch(\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-backend/ptb-remoteconfig-personal-merged.js?trial=20261121v3, requires-body=true, max-size=1048576, timeout=30

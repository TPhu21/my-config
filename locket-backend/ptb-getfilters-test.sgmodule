#!name=PTB Combined Catalog - ISOLATED TEST
#!desc=Dual-source catalog experiment for Firebase Remote Config + getFilters, no subscriber/auth/photo redirects. Disable after test.

[MITM]
enable = true
hostname = %APPEND% api.locketcamera.com, firebaseremoteconfig.googleapis.com

[Script]
ptb_getfilters_response = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/getFilters(\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-backend/ptb-getfilters-response-compat.js?trial=20261120a, requires-body=true, max-size=1048576, timeout=15
ptb_firebase_catalog = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/[^/]+\/namespaces\/[^/]+:fetch(\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-backend/ptb-remoteconfig-combined.js?trial=20261120a, requires-body=true, max-size=1048576, timeout=15

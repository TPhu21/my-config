#!name=PTB Hook Check - READ ONLY
#!desc=Independent Shadowrocket execution check for Locket getFilters and generateFilteredImage. No rewriting or redirecting.
#!system=ios

[MITM]
hostname = %APPEND% api.locketcamera.com

[Script]
ptb_hook_check = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/(?:getFilters|generateFilteredImage)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/feature/ptb-native-contract-diagnostics/locket-backend/ptb-hook-check.js, requires-body=false, timeout=20

#!name=Locket Personal + PTB Unified
#!desc=Single combined personal Remote Config and 10 PTB templates; keeps existing RevenueCat scripts. Native PTB generation remains experimental.
#!system=ios

[General]
update-url = https://raw.githubusercontent.com/TPhu21/my-config/feature/ptb-native-contract-diagnostics/locket-backend/locket-personal-ptb-unified.sgmodule

[MITM]
enable = true
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net

[Script]
# Exactly ONE Firebase :fetch response script: baseline personal + PTB merged.
# Numeric and named Firebase project IDs are both handled.
locket_personal_ptb_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/[^/]+\/namespaces\/[^/]+:fetch(?:\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/feature/ptb-native-contract-diagnostics/locket-backend/ptb-remoteconfig-personal-merged.js, requires-body=true, max-size=1048576, timeout=60

# Preserve the owner's original personal RevenueCat script URLs, unchanged.
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/deleteHeader.js, timeout=60
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket_sub.js, requires-body=true, max-size=-1, timeout=60

# PTB choices in the server filter list.
ptb_unified_getfilters = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/getFilters(?:\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/feature/ptb-native-contract-diagnostics/locket-backend/ptb-final-getfilters.js, requires-body=true, max-size=1048576, timeout=30

# Only personal PTB IDs are eligible for generation through owned Render staging.
ptb_unified_generate = type=http-request, pattern=^https:\/\/(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/generateFilteredImage(?:\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/feature/ptb-native-contract-diagnostics/locket-backend/ptb-final-generate.js, requires-body=true, max-size=131072, timeout=60

#!name=PTB Response Metadata Observer - ONE SHOT
#!desc=Read-only observer for generateFilteredImage after/before rewrite; disable after one test. Do not combine with other PTB observers.
[MITM]
enable = true
hostname = %APPEND% 163.223.9.98, us-central1-locket-4252a.cloudfunctions.net
[Script]
ptb_safe_response = type=http-response, pattern=^https:\/\/(163\.223\.9\.98|us-central1-locket-4252a\.cloudfunctions\.net)\/generateFilteredImage([?#].*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/feature/ptb-native-contract-diagnostics/locket-backend/ptb-safe-response-observer.js?schema=v2, requires-body=true, max-size=1048576, timeout=10

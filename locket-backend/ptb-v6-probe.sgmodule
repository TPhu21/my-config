#!name=PTB V6 - Minimal Hook Debug
#!desc=Read-only hook test built from the previously successful PTB Hook Check.
#!system=ios

[MITM]
hostname = %APPEND% api.locketcamera.com

[Script]
ptb_v6_probe = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/(?:getFilters|generateFilteredImage)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/TPhu21/my-config/feature/ptb-native-contract-diagnostics/locket-backend/ptb-v6-probe.js, requires-body=false, timeout=20

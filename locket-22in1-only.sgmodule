#!name=Locket Only - 22in1 Local
#!desc=Independent Locket-only module based on 22in1 feature categories; no external Worker or shared CA

[General]
update-url = https://raw.githubusercontent.com/TPhu21/my-config/main/locket-22in1-only.sgmodule

[MITM]
enable = true
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# Scripts hosted in your repository. Enable only ONE Locket module at a time.
locket_22_rc_request = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-22in1-rc-cache.js, timeout=60
locket_22_rc_response = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-22in1-rc.js, requires-body=true, max-size=2097152, timeout=60
locket_22_sub_request = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-22in1-rc-cache.js, timeout=60
locket_22_sub_response = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/TPhu21/my-config/main/locket-22in1-sub.js, requires-body=true, max-size=-1, timeout=60
